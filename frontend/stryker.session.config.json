{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.mutation.json",
  "mutate": ["src/shared/api/api-url.ts", "src/shared/api/client.ts", "src/shared/api/http-client.ts", "src/server/api-proxy.ts", "vite.config.ts", "src/App.tsx", "src/shared/api/query-client.ts", "src/shared/hooks/use-session.tsx", "src/shared/auth/google-identity.ts", "src/shared/auth/google-sign-in.tsx", "src/shared/ui/shell.tsx"],
  "coverageAnalysis": "perTest",
  "concurrency": 1,
  "maxTestRunnerReuse": 25,
  "thresholds": { "high": 90, "low": 85, "break": 85 },
  "vitest": { "configFile": "vitest.session.config.ts", "related": false, "pool": "forks" },
  "reporters": ["progress", "clear-text", "json", "html"],
  "jsonReporter": { "fileName": "reports/mutation/session/mutation.json" },
  "htmlReporter": { "fileName": "reports/mutation/session/mutation.html" }
}
