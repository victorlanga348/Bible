{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.app.json",
  "mutate": ["src/**/*.ts", "src/**/*.tsx", "!src/test/**", "!src/**/*.d.ts", "vite.config.ts"],
  "coverageAnalysis": "perTest",
  "concurrency": 1,
  "maxTestRunnerReuse": 25,
  "thresholds": { "high": 90, "low": 85, "break": 85 },
  "vitest": { "configFile": "vitest.config.ts", "related": false, "pool": "forks" },
  "reporters": ["progress", "clear-text", "json", "html"],
  "jsonReporter": { "fileName": "reports/mutation/global/mutation.json" },
  "htmlReporter": { "fileName": "reports/mutation/global/mutation.html" }
}
