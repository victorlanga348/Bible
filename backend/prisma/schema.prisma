generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas = ["app"]
}

model AiConversation {
  id String @id @db.Uuid
  ownerId String @map("owner_id")
  studyId String @map("study_id") @db.Uuid
  studyVersion BigInt @map("study_version")
  revision Int
  document Json @db.JsonB
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  @@index([ownerId,id], map: "ai_conversation_owner_id_idx")
  @@map("ai_conversation")
  @@schema("app")
}

model AiAnalysis {
  id String @id @db.Uuid
  ownerId String @map("owner_id")
  studyId String @map("study_id") @db.Uuid
  studyVersion BigInt @map("study_version")
  document Json @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([ownerId,id], map: "ai_analysis_owner_id_idx")
  @@map("ai_analysis")
  @@schema("app")
}

model CanonTranslation {
  id String @id
  name String
  language String
  canonId String @map("canon_id")
  sourceUrl String @map("source_url")
  sourceSha256 String @map("source_sha256")
  retrievedAt String @map("retrieved_at")
  licenseId String @map("license_id")
  licenseUrl String @map("license_url")
  attribution String
  books CanonBook[]
  @@map("canon_translation")
  @@schema("app")
}

model CanonBook {
  translationId String @map("translation_id")
  code String
  name String
  order BigInt
  translation CanonTranslation @relation(fields: [translationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  chapters CanonChapter[]
  @@id([translationId, code])
  @@unique([translationId, order])
  @@map("canon_book")
  @@schema("app")
}

model CanonChapter {
  translationId String @map("translation_id")
  bookCode String @map("book_code")
  number BigInt
  book CanonBook @relation(fields: [translationId, bookCode], references: [translationId, code], onDelete: Restrict, onUpdate: Cascade)
  verses CanonVerse[]
  @@id([translationId, bookCode, number])
  @@map("canon_chapter")
  @@schema("app")
}

model CanonVerse {
  translationId String @map("translation_id")
  bookCode String @map("book_code")
  chapter BigInt
  number BigInt
  text String
  chapterRecord CanonChapter @relation(fields: [translationId, bookCode, chapter], references: [translationId, bookCode, number], onDelete: Restrict, onUpdate: Cascade)
  @@id([translationId, bookCode, chapter, number])
  @@map("canon_verse")
  @@schema("app")
}

model SourceLibrarySource {
  id             String @id
  title          String
  author         String
  translator     String?
  language       String
  edition        String
  kind           String
  originUrl      String @map("origin_url")
  snapshotSha256 String @map("snapshot_sha256")
  retrievedAt    String @map("retrieved_at")
  rightsStatement String @map("rights_statement")
  rightsUrl      String @map("rights_url")
  attribution    String
  permissions    Json
  limitations    String
  excerpts       SourceLibraryExcerpt[]

  @@map("source_library_source")
  @@schema("app")
}

model SourceLibraryExcerpt {
  id         String @id
  sourceId   String @map("source_id")
  locator    String
  order      BigInt
  text       String
  textSha256 String @map("text_sha256")
  originUrl  String? @map("origin_url")
  source     SourceLibrarySource @relation(fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  passageLinks SourceLibraryPassageLink[]

  @@unique([sourceId, locator], map: "source_library_excerpt_source_locator_key")
  @@unique([sourceId, order], map: "source_library_excerpt_source_order_key")
  @@map("source_library_excerpt")
  @@schema("app")
}

model SourceLibraryPassageLink {
  id String @id
  excerptId String @map("excerpt_id")
  translationId String @map("translation_id")
  bookCode String @map("book_code")
  chapter BigInt
  fromVerse BigInt @map("from_verse")
  toVerse BigInt @map("to_verse")
  nature String
  rationale String
  excerpt SourceLibraryExcerpt @relation(fields: [excerptId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([translationId, bookCode, chapter, fromVerse, toVerse], map: "source_library_passage_link_selection_idx")
  @@map("source_library_passage_link")
  @@schema("app")
}

model StudyRecord {
  id String @id @db.Uuid
  ownerId String @map("owner_id")
  currentVersion BigInt @map("current_version")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  versions StudyVersion[]

  @@index([ownerId, createdAt(sort: Desc), id(sort: Desc)], map: "study_record_owner_created_id_idx")
  @@map("study_record")
  @@schema("app")
}

model StudyVersion {
  studyId String @map("study_id") @db.Uuid
  number BigInt
  document Json @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  study StudyRecord @relation(fields: [studyId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([studyId, number])
  @@map("study_version")
  @@schema("app")
}
