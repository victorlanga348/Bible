generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas = ["app"]
}

model CanonTranslation {
  id String @id
  name String
  language String
  canonId String @map("canon_id")
  sourceUrl String @map("source_url")
  sourceSha256 String @map("source_sha256")
  retrievedAt String @map("retrieved_at")
  licenseId String @map("license_id")
  licenseUrl String @map("license_url")
  attribution String
  books CanonBook[]
  @@map("canon_translation")
  @@schema("app")
}

model CanonBook {
  translationId String @map("translation_id")
  code String
  name String
  order BigInt
  translation CanonTranslation @relation(fields: [translationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  chapters CanonChapter[]
  @@id([translationId, code])
  @@unique([translationId, order])
  @@map("canon_book")
  @@schema("app")
}

model CanonChapter {
  translationId String @map("translation_id")
  bookCode String @map("book_code")
  number BigInt
  book CanonBook @relation(fields: [translationId, bookCode], references: [translationId, code], onDelete: Restrict, onUpdate: Cascade)
  verses CanonVerse[]
  @@id([translationId, bookCode, number])
  @@map("canon_chapter")
  @@schema("app")
}

model CanonVerse {
  translationId String @map("translation_id")
  bookCode String @map("book_code")
  chapter BigInt
  number BigInt
  text String
  chapterRecord CanonChapter @relation(fields: [translationId, bookCode, chapter], references: [translationId, bookCode, number], onDelete: Restrict, onUpdate: Cascade)
  @@id([translationId, bookCode, chapter, number])
  @@map("canon_verse")
  @@schema("app")
}

model SourceLibrarySource {
  id             String @id
  title          String
  author         String
  translator     String?
  language       String
  edition        String
  kind           String
  originUrl      String @map("origin_url")
  snapshotSha256 String @map("snapshot_sha256")
  retrievedAt    String @map("retrieved_at")
  rightsStatement String @map("rights_statement")
  rightsUrl      String @map("rights_url")
  attribution    String
  permissions    Json
  limitations    String
  excerpts       SourceLibraryExcerpt[]

  @@map("source_library_source")
  @@schema("app")
}

model SourceLibraryExcerpt {
  id         String @id
  sourceId   String @map("source_id")
  locator    String
  order      BigInt
  text       String
  textSha256 String @map("text_sha256")
  originUrl  String? @map("origin_url")
  source     SourceLibrarySource @relation(fields: [sourceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([sourceId, locator], map: "source_library_excerpt_source_locator_key")
  @@unique([sourceId, order], map: "source_library_excerpt_source_order_key")
  @@map("source_library_excerpt")
  @@schema("app")
}
