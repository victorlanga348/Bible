{
  "name": "biblia-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11.13.0 <12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test scripts --max-warnings 0",
    "start": "node --env-file-if-exists=.env scripts/start.cjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --watchman=false",
    "test:unit": "npm run test -- --selectProjects unit",
    "test:integration": "npm run test -- --selectProjects integration",
    "test:e2e": "npm run test -- --selectProjects e2e",
    "test:coverage": "npm run test -- --coverage",
    "test:architecture": "node --test scripts/architecture.test.cjs",
    "test:tooling": "node --test scripts/*.test.cjs",
    "test:mutation": "stryker run && node scripts/check-mutation.cjs",
    "test:mutation:incremental": "stryker run --incremental --incrementalFile reports/mutation/incremental.json && node scripts/check-mutation.cjs",
    "prisma:generate": "prisma generate",
    "db:migrate:test": "npm run build && node scripts/migrate-test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.2.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/jest-runner": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.13.0",
    "jest": "30.5.2",
    "jest-environment-node": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
