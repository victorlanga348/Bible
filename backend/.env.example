# Copiar para .env e preencher localmente; nunca versionar valores privados.
NODE_ENV=development
PORT=3000
DATABASE_URL=
# Chave local privada com pelo menos32 bytes UTF-8; vazia fecha as rotas privadas.
jwtSecret=
# Opcional: web client Google Identity Services; manter vazio para acesso só local/CLI.
GOOGLE_CLIENT_ID=
BIBLE_DEV_DB_PASSWORD=
BIBLE_TEST_DB_PASSWORD=
